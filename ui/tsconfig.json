{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*":              ["./*"],
      "@/components/*":  ["./components/*"],
      "@/components/ui": ["./components/ui/index.ts"],
      "@/hooks":         ["./hooks/index.ts"],
      "@/hooks/*":       ["./hooks/*"],
      "@/providers":     ["./providers/index.ts"],
      "@/providers/*":   ["./providers/*"],
      "@/services":      ["./services/index.ts"],
      "@/services/*":    ["./services/*"],
      "@/types":         ["./types/index.ts"],
      "@/types/*":       ["./types/*"],
      "@/constants":     ["./constants/index.ts"],
      "@/constants/*":   ["./constants/*"],
      "@/utils":         ["./utils/index.ts"],
      "@/utils/*":       ["./utils/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}